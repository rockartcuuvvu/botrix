<%- include('../partials/header') %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
  <div>
    <span class="text-xs font-bold text-amber-600 uppercase tracking-widest bg-amber-50 px-2.5 py-1 rounded-md">Admin Portal</span>
    <h1 class="text-2xl font-extrabold text-slate-900 mt-1">Review & Process Quote Requests</h1>
    <p class="text-slate-500 text-xs mt-1">Assign custom product prices to load them directly into the client's catalogue.</p>
  </div>
</div>

<% if (quotes && quotes.length > 0) { %>
  <div class="space-y-6">
    <% quotes.forEach(quote => { %>
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-4 mb-4 gap-2">
          <div>
            <span class="font-extrabold text-slate-900 text-base"><%= quote.requestNumber %></span>
            <span class="text-xs text-slate-500 ml-2">Client: <strong><%= quote.client ? quote.client.company : 'Unknown' %></strong> (<%= quote.client ? quote.client.name : '' %> - <%= quote.client ? quote.client.email : '' %>)</span>
          </div>
          <span class="bg-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full"><%= quote.status %></span>
        </div>

        <form onsubmit="saveQuotePrices(event, '<%= quote._id %>')" class="space-y-4">
          <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Quote Items & Assign Pricing:</h4>

          <% quote.items.forEach(item => { %>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-slate-50 p-4 rounded-xl gap-4">
              <div class="flex-grow">
                <span class="font-bold text-slate-800 text-sm"><%= item.product ? item.product.title : item.customItemName %></span>
                <span class="text-xs text-slate-500 block">Requested Qty: <%= item.quantity %> | Category: <%= item.product ? item.product.category : 'Custom' %></span>
                <% if (item.product) { %>
                  <span class="text-[11px] text-slate-400 block font-medium">Internal Base Price: $<%= item.product.listPrice.toFixed(2) %></span>
                <% } %>
                <% if (item.notes) { %>
                  <p class="text-xs text-slate-600 bg-white p-2 rounded border border-slate-200 mt-1">Client Notes: <%= item.notes %></p>
                <% } %>
              </div>

              <% if (item.product) { %>
                <div class="w-full sm:w-48">
                  <label class="block text-[11px] font-bold text-slate-700 mb-1">Set Custom Unit Price ($)</label>
                  <input type="number" step="0.01" min="0" data-product-id="<%= item.product._id %>" value="<%= item.offeredPrice || item.product.listPrice %>" class="item-price-input w-full border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold text-emerald-700 focus:ring-2 focus:ring-emerald-500">
                </div>
              <% } %>
            </div>
          <% }); %>

          <div class="pt-2">
            <label class="block text-xs font-bold text-slate-700 mb-1">Admin Response / Contract Notes</label>
            <textarea id="adminNotes_<%= quote._id %>" rows="2" placeholder="e.g. Approved standard corporate volume tier discount..." class="w-full border border-slate-300 rounded-xl px-3 py-2 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-indigo-500"><%= quote.adminNotes || '' %></textarea>
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-slate-100">
            <div class="flex items-center space-x-2">
              <label class="text-xs font-bold text-slate-700">Update Status:</label>
              <select id="status_<%= quote._id %>" class="border border-slate-300 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-800">
                <option value="Quoted" <%= quote.status === 'Quoted' ? 'selected' : '' %>>Quoted (Load Prices to Catalogue)</option>
                <option value="Accepted" <%= quote.status === 'Accepted' ? 'selected' : '' %>>Accepted</option>
                <option value="Pending" <%= quote.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                <option value="Rejected" <%= quote.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
              </select>
            </div>

            <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold py-2.5 px-5 rounded-xl transition shadow-md flex items-center space-x-2">
              <i class="fa-solid fa-cloud-arrow-up"></i>
              <span>Save & Load Prices to Client Catalogue</span>
            </button>
          </div>
        </form>
      </div>
    <% }); %>
  </div>
<% } else { %>
  <div class="py-16 text-center bg-white rounded-2xl border border-slate-200">
    <i class="fa-solid fa-inbox text-4xl text-slate-300 mb-3"></i>
    <h3 class="text-lg font-bold text-slate-800">No Quote Requests Found</h3>
  </div>
<% } %>

<script>
  async function saveQuotePrices(e, quoteId) {
    e.preventDefault();
    const form = e.target;
    const priceInputs = form.querySelectorAll('.item-price-input');
    const itemPrices = [];

    priceInputs.forEach(input => {
      const productId = input.getAttribute('data-product-id');
      const price = parseFloat(input.value);
      if (productId && !isNaN(price)) {
        itemPrices.push({ productId, price });
      }
    });

    const adminNotes = document.getElementById(`adminNotes_${quoteId}`).value;
    const status = document.getElementById(`status_${quoteId}`).value;

    try {
      const res = await fetch(`/api/quotes/${quoteId}/respond`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ itemPrices, adminNotes, status })
      });

      const data = await res.json();
      if (res.ok) {
        alert('Quote response saved! Custom pricing has been loaded to the client catalogue.');
        window.location.reload();
      } else {
        alert(data.error || 'Failed to update quote.');
      }
    } catch (err) {
      alert('Error updating quote request.');
    }
  }
</script>

<%- include('../partials/footer') %>
