<%- include('../partials/header') %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
  <div>
    <span class="text-xs font-bold text-amber-600 uppercase tracking-widest bg-amber-50 px-2.5 py-1 rounded-md">Admin Portal</span>
    <h1 class="text-2xl font-extrabold text-slate-900 mt-1">Client Live Chat Portal</h1>
    <p class="text-slate-500 text-xs mt-1">Direct communication channels with registered B2B clients.</p>
  </div>
</div>

<% if (threads && threads.length > 0) { %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% threads.forEach(thread => { %>
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between hover:shadow-md transition">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="font-bold text-slate-900 text-base"><%= thread.client ? thread.client.company : 'Client' %></span>
            <% if (thread.unreadCount > 0) { %>
              <span class="bg-rose-500 text-white text-[10px] font-extrabold px-2 py-0.5 rounded-full"><%= thread.unreadCount %> new</span>
            <% } %>
          </div>
          <p class="text-xs text-slate-500"><%= thread.client ? thread.client.name : '' %> (<%= thread.client ? thread.client.email : '' %>)</p>
          <% if (thread.lastMessage) { %>
            <div class="mt-4 bg-slate-50 p-3 rounded-xl border border-slate-100">
              <span class="text-[10px] font-bold text-slate-400 uppercase block">Last Message</span>
              <p class="text-xs text-slate-700 italic line-clamp-2 mt-0.5"><%= thread.lastMessage.content %></p>
            </div>
          <% } %>
        </div>

        <a href="/portal/messages?clientId=<%= thread.client._id %>" class="mt-5 w-full bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold py-2.5 px-4 rounded-xl transition text-center block flex items-center justify-center space-x-2">
          <i class="fa-solid fa-comments"></i>
          <span>Open Chat Thread</span>
        </a>
      </div>
    <% }); %>
  </div>
<% } else { %>
  <div class="py-16 text-center bg-white rounded-2xl border border-slate-200">
    <i class="fa-solid fa-comments text-4xl text-slate-300 mb-3"></i>
    <h3 class="text-lg font-bold text-slate-800">No Active Chat Threads</h3>
  </div>
<% } %>

<%- include('../partials/footer') %>
