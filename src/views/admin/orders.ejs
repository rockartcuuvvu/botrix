<%- include('../partials/header') %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
  <div>
    <span class="text-xs font-bold text-amber-600 uppercase tracking-widest bg-amber-50 px-2.5 py-1 rounded-md">Admin Portal</span>
    <h1 class="text-2xl font-extrabold text-slate-900 mt-1">Manage B2B Orders</h1>
    <p class="text-slate-500 text-xs mt-1">Review orders placed by corporate clients with custom catalogue prices.</p>
  </div>
</div>

<% if (orders && orders.length > 0) { %>
  <div class="space-y-4">
    <% orders.forEach(order => { %>
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-4 mb-4 gap-2">
          <div>
            <span class="font-extrabold text-slate-900 text-base"><%= order.orderNumber %></span>
            <span class="text-xs text-slate-500 ml-2">Client: <strong><%= order.client ? order.client.company : 'Unknown' %></strong> (<%= order.client ? order.client.email : '' %>)</span>
          </div>
          <div class="flex items-center space-x-3">
            <span class="text-xs font-bold text-slate-500">Total: <strong class="text-emerald-600 text-sm">$<%= order.totalAmount.toFixed(2) %></strong></span>
            <select onchange="updateOrderStatus('<%= order._id %>', this.value)" class="border border-slate-300 rounded-xl px-3 py-1 text-xs font-bold text-slate-800">
              <% ['Pending', 'Processing', 'Shipped', 'Completed', 'Cancelled'].forEach(st => { %>
                <option value="<%= st %>" <%= order.status === st ? 'selected' : '' %>><%= st %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="space-y-2">
          <% order.items.forEach(item => { %>
            <div class="flex items-center justify-between text-xs bg-slate-50 p-3 rounded-xl">
              <div>
                <span class="font-bold text-slate-800"><%= item.title %></span>
                <span class="text-slate-500 text-xs ml-2">Qty: <%= item.quantity %> @ $<%= item.unitPrice.toFixed(2) %></span>
              </div>
              <span class="font-bold text-slate-900">$<%= item.subtotal.toFixed(2) %></span>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </div>
<% } else { %>
  <div class="py-16 text-center bg-white rounded-2xl border border-slate-200">
    <i class="fa-solid fa-boxes-packing text-4xl text-slate-300 mb-3"></i>
    <h3 class="text-lg font-bold text-slate-800">No Orders Found</h3>
  </div>
<% } %>

<script>
  async function updateOrderStatus(orderId, status) {
    try {
      const res = await fetch(`/api/cart-orders/admin/orders/${orderId}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ status })
      });

      if (res.ok) {
        alert('Order status updated!');
      } else {
        alert('Failed to update status.');
      }
    } catch (err) {
      alert('Error updating order status.');
    }
  }
</script>

<%- include('../partials/footer') %>
