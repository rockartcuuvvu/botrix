<%- include('partials/header') %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
  <div>
    <h1 class="text-2xl font-extrabold text-slate-900">Purchase Orders & History</h1>
    <p class="text-slate-500 text-xs mt-1">Orders placed through your custom quoted catalogue.</p>
  </div>
  <a href="/portal/catalogue" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition flex items-center space-x-2">
    <i class="fa-solid fa-cart-shopping"></i>
    <span>Shop Quoted Catalogue</span>
  </a>
</div>

<% if (orders && orders.length > 0) { %>
  <div class="space-y-4">
    <% orders.forEach(order => { %>
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-4 mb-4 gap-2">
          <div>
            <span class="font-extrabold text-slate-900 text-base"><%= order.orderNumber %></span>
            <span class="text-xs text-slate-400 ml-2"><%= new Date(order.createdAt).toLocaleDateString() %></span>
          </div>
          <div class="flex items-center space-x-3">
            <span class="text-xs font-bold text-slate-500">Total: <strong class="text-emerald-600 text-sm">$<%= order.totalAmount.toFixed(2) %></strong></span>
            <span class="bg-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full"><%= order.status %></span>
          </div>
        </div>

        <div class="space-y-2">
          <% order.items.forEach(item => { %>
            <div class="flex items-center justify-between text-xs bg-slate-50 p-3 rounded-xl">
              <div>
                <span class="font-bold text-slate-800"><%= item.title %></span>
                <span class="text-slate-500 text-xs ml-2">Qty: <%= item.quantity %> @ $<%= item.unitPrice.toFixed(2) %></span>
              </div>
              <span class="font-bold text-slate-900">$<%= item.subtotal.toFixed(2) %></span>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </div>
<% } else { %>
  <div class="py-16 text-center bg-white rounded-2xl border border-slate-200">
    <i class="fa-solid fa-receipt text-4xl text-slate-300 mb-3"></i>
    <h3 class="text-lg font-bold text-slate-800">No Orders Placed Yet</h3>
    <p class="text-slate-500 text-xs mt-1">Visit your quoted catalogue to order items with approved prices.</p>
  </div>
<% } %>

<%- include('partials/footer') %>
