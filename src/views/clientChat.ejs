<%- include('partials/header') %>

<div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col h-[700px]">
  <div class="p-4 bg-slate-900 text-white flex items-center justify-between border-b border-slate-800">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-full bg-indigo-600 flex items-center justify-center font-bold text-lg">
        <i class="fa-solid fa-headset"></i>
      </div>
      <div>
        <h3 class="font-bold text-sm">Direct Seller Support & Quote Desk</h3>
        <p class="text-xs text-indigo-300">Live Client Chat Portal • Encrypted Communications</p>
      </div>
    </div>
    <span class="text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full border border-emerald-500/30 flex items-center">
      <span class="w-2 h-2 rounded-full bg-emerald-400 mr-1.5 animate-pulse"></span> Sales Representative Active
    </span>
  </div>

  <!-- Messages Scroll Container -->
  <div id="messagesContainer" class="flex-grow p-6 overflow-y-auto space-y-4 bg-slate-50">
    <% if (messages && messages.length > 0) { %>
      <% messages.forEach(msg => { %>
        <% const isMe = (user && msg.sender && msg.sender._id.toString() === user._id.toString()) || (msg.senderRole === user.role); %>
        <div class="flex flex-col <%= isMe ? 'items-end' : 'items-start' %>">
          <div class="flex items-center space-x-2 mb-1">
            <span class="text-[10px] font-bold text-slate-500"><%= msg.sender ? msg.sender.name : (msg.senderRole === 'admin' ? 'Nexus Support' : 'Client') %></span>
            <span class="text-[10px] text-slate-400"><%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
          </div>
          <div class="max-w-md px-4 py-3 rounded-2xl text-xs font-medium leading-relaxed <%= isMe ? 'bg-indigo-600 text-white rounded-br-none shadow-sm' : 'bg-white text-slate-800 border border-slate-200 rounded-bl-none shadow-sm' %>">
            <%= msg.content %>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="text-center py-12 text-slate-400 text-xs">
        <i class="fa-solid fa-comments text-3xl text-slate-300 mb-2"></i>
        <p>No messages yet. Send a message to start communicating with your dedicated sales representative.</p>
      </div>
    <% } %>
  </div>

  <!-- Message Input Bar -->
  <form id="chatForm" onsubmit="sendChatMessage(event)" class="p-4 bg-white border-t border-slate-200 flex items-center space-x-3">
    <input type="hidden" id="targetClientId" value="<%= clientId %>">
    <input type="text" id="chatInput" placeholder="Type your message or inquiry..." required class="flex-grow border border-slate-300 rounded-xl px-4 py-3 text-xs font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none">
    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-6 py-3 rounded-xl text-xs transition shadow-md flex items-center space-x-2">
      <span>Send</span>
      <i class="fa-solid fa-paper-plane"></i>
    </button>
  </form>
</div>

<script>
  const socket = io();
  const clientId = "<%= clientId %>";
  const userRole = "<%= user ? user.role : 'client' %>";

  if (userRole === 'admin') {
    socket.emit('joinAdminRoom');
  } else {
    socket.emit('joinClientRoom', clientId);
  }

  socket.on('chatMessage', (msg) => {
    if (msg.client === clientId) {
      appendMessage(msg);
      scrollToBottom();
    }
  });

  function scrollToBottom() {
    const container = document.getElementById('messagesContainer');
    container.scrollTop = container.scrollHeight;
  }

  function appendMessage(msg) {
    const container = document.getElementById('messagesContainer');
    const isMe = (msg.senderRole === userRole);
    const timeStr = new Date(msg.createdAt || Date.now()).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

    const msgHtml = `
      <div class="flex flex-col ${isMe ? 'items-end' : 'items-start'} mb-4">
        <div class="flex items-center space-x-2 mb-1">
          <span class="text-[10px] font-bold text-slate-500">${msg.sender ? msg.sender.name : (msg.senderRole === 'admin' ? 'Nexus Support' : 'Client')}</span>
          <span class="text-[10px] text-slate-400">${timeStr}</span>
        </div>
        <div class="max-w-md px-4 py-3 rounded-2xl text-xs font-medium leading-relaxed ${isMe ? 'bg-indigo-600 text-white rounded-br-none shadow-sm' : 'bg-white text-slate-800 border border-slate-200 rounded-bl-none shadow-sm'}">
          ${msg.content}
        </div>
      </div>
    `;

    container.insertAdjacentHTML('beforeend', msgHtml);
  }

  async function sendChatMessage(e) {
    e.preventDefault();
    const input = document.getElementById('chatInput');
    const content = input.value.trim();
    if (!content) return;

    try {
      const res = await fetch('/api/messages/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          content,
          clientId
        })
      });

      if (res.ok) {
        input.value = '';
        scrollToBottom();
      } else {
        alert('Failed to send message.');
      }
    } catch (err) {
      alert('Error sending message.');
    }
  }

  scrollToBottom();
</script>

<%- include('partials/footer') %>
