<%- include('partials/header') %>

<div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
  <div>
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Corporate B2B Product Catalog</h1>
    <p class="text-slate-500 text-sm mt-1">Browse Stationery, Online Development Packages, Computers & Custom Enterprise Equipment.</p>
  </div>

  <form action="/catalog" method="GET" class="flex items-center space-x-2">
    <input type="hidden" name="category" value="<%= selectedCategory %>">
    <div class="relative">
      <input type="text" name="search" value="<%= search %>" placeholder="Search catalog..." class="pl-9 pr-4 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-64">
      <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400 text-xs"></i>
    </div>
    <button type="submit" class="bg-slate-900 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-slate-800 transition">Search</button>
  </form>
</div>

<!-- Category Tabs -->
<div class="flex items-center space-x-2 overflow-x-auto pb-4 mb-6 border-b border-slate-200">
  <% const categories = ['All', 'Stationery', 'Online Development Packages', 'Computers', 'Custom Requests']; %>
  <% categories.forEach(cat => { %>
    <a href="/catalog?category=<%= encodeURIComponent(cat) %>" class="px-4 py-2 rounded-xl text-xs font-bold transition whitespace-nowrap <%= selectedCategory === cat ? 'bg-indigo-600 text-white shadow-sm' : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200' %>">
      <%= cat %>
    </a>
  <% }); %>
</div>

<!-- Product Cards Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
  <% if (products && products.length > 0) { %>
    <% products.forEach(product => { %>
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition flex flex-col overflow-hidden">
        <div class="h-48 bg-slate-100 relative overflow-hidden flex items-center justify-center p-4">
          <img src="<%= product.image %>" alt="<%= product.title %>" class="max-h-full max-w-full object-contain">
          <span class="absolute top-3 left-3 bg-slate-900/80 text-white text-[10px] uppercase font-bold px-2.5 py-1 rounded-full backdrop-blur-sm">
            <%= product.category %>
          </span>
        </div>

        <div class="p-5 flex-grow flex flex-col justify-between">
          <div>
            <h3 class="font-bold text-slate-900 text-base leading-snug line-clamp-1"><%= product.title %></h3>
            <p class="text-slate-500 text-xs mt-2 line-clamp-2 leading-relaxed"><%= product.description %></p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex flex-col space-y-3">
            <% if (product.hasCustomPrice) { %>
              <div class="flex items-center justify-between">
                <span class="text-xs text-slate-500 font-medium">Your Quoted Price:</span>
                <span class="text-lg font-extrabold text-emerald-600"><%= product.priceDisplay %></span>
              </div>
              <% if (product.canAddToCart) { %>
                <button onclick="addToCart('<%= product._id %>', '<%= product.title %>', <%= product.userPrice %>)" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold py-2.5 px-4 rounded-xl transition flex items-center justify-center space-x-2">
                  <i class="fa-solid fa-cart-plus"></i>
                  <span>Add to Order Cart</span>
                </button>
              <% } %>
            <% } else { %>
              <div class="bg-amber-50 border border-amber-200 p-3 rounded-xl flex items-center space-x-2 text-amber-800 text-xs">
                <i class="fa-solid fa-lock text-amber-600 text-sm"></i>
                <div class="font-medium">Prices Gated: Request Quote to unlock custom price</div>
              </div>

              <% if (user) { %>
                <button onclick="openQuoteModal('<%= product._id %>', '<%= product.title %>')" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold py-2.5 px-4 rounded-xl transition flex items-center justify-center space-x-2">
                  <i class="fa-solid fa-paper-plane"></i>
                  <span>Request Quote for Item</span>
                </button>
              <% } else { %>
                <a href="/register" class="w-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold py-2.5 px-4 rounded-xl transition text-center block">
                  Register to Request Quote
                </a>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="col-span-full py-16 text-center bg-white rounded-2xl border border-slate-200">
      <i class="fa-solid fa-box-open text-4xl text-slate-300 mb-3"></i>
      <h3 class="text-lg font-bold text-slate-800">No products found</h3>
      <p class="text-slate-500 text-xs mt-1">Try selecting a different category or clearing search filters.</p>
    </div>
  <% } %>
</div>

<!-- Quote Modal -->
<div id="quoteModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl relative">
    <button onclick="closeQuoteModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-lg">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <h3 class="text-xl font-extrabold text-slate-900 flex items-center space-x-2">
      <i class="fa-solid fa-file-invoice-dollar text-indigo-600"></i>
      <span>Request B2B Quote</span>
    </h3>
    <p class="text-slate-500 text-xs mt-1">Submit your request to receive tailored corporate pricing added to your portal catalogue.</p>

    <form id="quoteForm" onsubmit="submitQuoteRequest(event)" class="mt-5 space-y-4">
      <input type="hidden" id="modalProductId">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Product Title</label>
        <input type="text" id="modalProductTitle" readonly class="w-full bg-slate-100 border border-slate-300 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800">
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Estimated Quantity</label>
          <input type="number" id="modalQuantity" min="1" value="10" required class="w-full border border-slate-300 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Target Delivery</label>
          <input type="text" placeholder="e.g. Next Week" class="w-full border border-slate-300 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500">
        </div>
      </div>
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Custom Notes / Specs / Requirements</label>
        <textarea id="modalNotes" rows="3" placeholder="Provide any special instructions or customization requirements..." class="w-full border border-slate-300 rounded-xl px-3 py-2 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-indigo-500"></textarea>
      </div>

      <div class="flex justify-end space-x-3 pt-3">
        <button type="button" onclick="closeQuoteModal()" class="px-4 py-2 border border-slate-300 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-50 transition">Cancel</button>
        <button type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition shadow-md">Submit Quote Request</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openQuoteModal(prodId, prodTitle) {
    document.getElementById('modalProductId').value = prodId;
    document.getElementById('modalProductTitle').value = prodTitle;
    document.getElementById('quoteModal').classList.remove('hidden');
    document.getElementById('quoteModal').classList.add('flex');
  }

  function closeQuoteModal() {
    document.getElementById('quoteModal').classList.add('hidden');
    document.getElementById('quoteModal').classList.remove('flex');
  }

  async function submitQuoteRequest(e) {
    e.preventDefault();
    const productId = document.getElementById('modalProductId').value;
    const quantity = document.getElementById('modalQuantity').value;
    const notes = document.getElementById('modalNotes').value;

    try {
      const res = await fetch('/api/quotes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          items: [{ productId, quantity, notes }]
        })
      });

      const data = await res.json();
      if (res.ok) {
        alert('Quote request submitted successfully! Once reviewed, your custom prices will be loaded to your portal catalogue.');
        closeQuoteModal();
        window.location.href = '/portal/quotes';
      } else {
        alert(data.error || 'Failed to submit quote request');
      }
    } catch (err) {
      alert('Error submitting quote request.');
    }
  }

  async function addToCart(productId, title, price) {
    let cart = JSON.parse(localStorage.getItem('b2b_cart') || '[]');
    const existing = cart.find(i => i.productId === productId);
    if (existing) {
      existing.quantity += 1;
    } else {
      cart.push({ productId, title, price, quantity: 1 });
    }
    localStorage.setItem('b2b_cart', JSON.stringify(cart));
    alert(`${title} added to cart! Visit your portal catalogue to review & checkout.`);
  }
</script>

<%- include('partials/footer') %>
