<%- include('partials/header') %>

<div class="max-w-xl mx-auto my-8 bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
  <div class="text-center mb-6">
    <div class="inline-flex p-3 bg-indigo-50 text-indigo-600 rounded-2xl mb-2">
      <i class="fa-solid fa-building text-2xl"></i>
    </div>
    <h2 class="text-2xl font-extrabold text-slate-900">Register B2B Account</h2>
    <p class="text-slate-500 text-xs mt-1">Register to submit custom quote requests and load custom corporate pricing to your catalogue.</p>
  </div>

  <form action="/api/auth/register" method="POST" class="space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Contact Name *</label>
        <input type="text" name="name" required placeholder="John Doe" class="w-full border border-slate-300 rounded-xl px-4 py-2.5 text-xs font-semibold focus:ring-2 focus:ring-indigo-500">
      </div>
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Company Name *</label>
        <input type="text" name="company" required placeholder="Acme Enterprises Corp" class="w-full border border-slate-300 rounded-xl px-4 py-2.5 text-xs font-semibold focus:ring-2 focus:ring-indigo-500">
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Corporate Email Address *</label>
        <input type="email" name="email" required placeholder="john@acme.com" class="w-full border border-slate-300 rounded-xl px-4 py-2.5 text-xs font-semibold focus:ring-2 focus:ring-indigo-500">
      </div>
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Phone Number</label>
        <input type="text" name="phone" placeholder="+1 (555) 000-0000" class="w-full border border-slate-300 rounded-xl px-4 py-2.5 text-xs font-semibold focus:ring-2 focus:ring-indigo-500">
      </div>
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">Password *</label>
      <input type="password" name="password" required placeholder="••••••••" class="w-full border border-slate-300 rounded-xl px-4 py-2.5 text-xs font-semibold focus:ring-2 focus:ring-indigo-500">
    </div>

    <div class="pt-2">
      <h4 class="text-xs font-bold text-slate-900 mb-2">Company Billing / Shipping Address</h4>
      <div class="space-y-3">
        <input type="text" name="street" placeholder="Street Address" class="w-full border border-slate-300 rounded-xl px-4 py-2 text-xs font-semibold focus:ring-2 focus:ring-indigo-500">
        <div class="grid grid-cols-3 gap-3">
          <input type="text" name="city" placeholder="City" class="border border-slate-300 rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-indigo-500">
          <input type="text" name="state" placeholder="State/Prov" class="border border-slate-300 rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-indigo-500">
          <input type="text" name="zip" placeholder="Zip/Postal" class="border border-slate-300 rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-indigo-500">
        </div>
      </div>
    </div>

    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl text-xs transition shadow-md mt-4">
      Create B2B Account & Get Started
    </button>
  </form>

  <div class="mt-6 pt-6 border-t border-slate-100 text-center text-xs text-slate-500">
    Already registered?
    <a href="/login" class="text-indigo-600 font-bold hover:underline">Log In Here</a>
  </div>
</div>

<%- include('partials/footer') %>
